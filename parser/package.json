{
  "name": "@pgsql/parser",
  "version": "1.6.2",
  "author": "Constructive <developers@constructive.io>",
  "description": "Multi-version PostgreSQL parser with dynamic version selection",
  "main": "./wasm/index.cjs",
  "module": "./wasm/index.mjs",
  "types": "./wasm/index.d.ts",
  "exports": {
    ".": {
      "types": "./wasm/index.d.ts",
      "import": "./wasm/index.mjs",
      "require": "./wasm/index.cjs"
    },
    "./v13": {
      "types": "./wasm/v13.d.ts",
      "import": "./wasm/v13.mjs",
      "require": "./wasm/v13.cjs"
    },
    "./v14": {
      "types": "./wasm/v14.d.ts",
      "import": "./wasm/v14.mjs",
      "require": "./wasm/v14.cjs"
    },
    "./v15": {
      "types": "./wasm/v15.d.ts",
      "import": "./wasm/v15.mjs",
      "require": "./wasm/v15.cjs"
    },
    "./v16": {
      "types": "./wasm/v16.d.ts",
      "import": "./wasm/v16.mjs",
      "require": "./wasm/v16.cjs"
    },
    "./v17": {
      "types": "./wasm/v17.d.ts",
      "import": "./wasm/v17.mjs",
      "require": "./wasm/v17.cjs"
    },
    "./v18": {
      "types": "./wasm/v18.d.ts",
      "import": "./wasm/v18.mjs",
      "require": "./wasm/v18.cjs"
    }
  },
  "files": [
    "wasm/**/*"
  ],
  "scripts": {
    "clean": "rimraf wasm",
    "prepare": "node scripts/prepare.js",
    "build": "npm run clean && npm run prepare",
    "build:full": "npm run clean && cross-env PARSER_BUILD_TYPE=full npm run prepare",
    "build:lts": "npm run clean && cross-env PARSER_BUILD_TYPE=lts npm run prepare",
    "test": "node --test test/parsing.test.js test/errors.test.js test/esm.test.mjs"
  },
  "keywords": [
    "postgresql",
    "parser",
    "sql",
    "ast",
    "multi-version"
  ],
  "license": "MIT",
  "devDependencies": {
    "cross-env": "^7.0.3",
    "rimraf": "^5.0.0"
  }
}
